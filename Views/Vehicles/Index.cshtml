@model IEnumerable<AutoSzerviz.Models.Vehicle>

@{
    ViewData["Title"] = "Saját Járművek";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Saját Járműveim</h2>
    <a asp-action="Create" class="btn btn-primary">Új Jármű Rögzítése</a>
</div>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>@Html.DisplayNameFor(model => model.LicensePlate)</th>
            <th>@Html.DisplayNameFor(model => model.MakeAndModel)</th>
            <th>@Html.DisplayNameFor(model => model.Year)</th>
            <th>Műveletek</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td><strong>@item.LicensePlate</strong></td>
            <td>@item.MakeAndModel</td>
            <td>@item.Year</td>
            <td>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Törlés</a>
            </td>
        </tr>
}
    </tbody>
</table>
