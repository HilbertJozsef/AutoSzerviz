@model AutoSzerviz.Models.Vehicle

@{
    ViewData["Title"] = "Új Jármű Rögzítése";
}

<h2>Új Jármű Rögzítése</h2>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div class="mb-3">
                <label asp-for="LicensePlate" class="form-label"></label>
                <input asp-for="LicensePlate" class="form-control" placeholder="pl. ABC-123 vagy AA-BB-123" />
                <span asp-validation-for="LicensePlate" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="MakeAndModel" class="form-label"></label>
                <input asp-for="MakeAndModel" class="form-control" placeholder="pl. Audi A4 2.0 TDI" />
                <span asp-validation-for="MakeAndModel" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Year" class="form-label"></label>
                <input asp-for="Year" class="form-control" type="number" value="2018" />
                <span asp-validation-for="Year" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-success">Mentés</button>
            <a asp-action="Index" class="btn btn-secondary">Vissza</a>
        </form>
    </div>
</div>