@model AutoSzerviz.Models.Appointment

@{
    ViewData["Title"] = "Új Időpont Foglalása";
}

<h2>Új Időpont Foglalása</h2>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div class="mb-3">
                <label asp-for="VehicleId" class="form-label">Válaszd ki a Járművedet</label>
                <select asp-for="VehicleId" class="form-select" asp-items="ViewBag.VehicleId"></select>
            </div>
            <div class="mb-3">
                <label asp-for="ServiceId" class="form-label">Válaszd ki a Szolgáltatást</label>
                <select asp-for="ServiceId" class="form-select" asp-items="ViewBag.ServiceId"></select>
            </div>
            <div class="mb-3">
                <label asp-for="AppointmentDate" class="form-label">Kívánt Időpont</label>
                <input asp-for="AppointmentDate" class="form-control" type="datetime-local" />
                <span asp-validation-for="AppointmentDate" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-success">Foglalás Véglegesítése</button>
            <a asp-action="Index" class="btn btn-secondary">Vissza</a>
        </form>
    </div>
</div>